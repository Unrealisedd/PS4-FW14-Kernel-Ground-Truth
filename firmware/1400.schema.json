      "items": {
        "oneOf": [
          {"const": {"name": "xfast_syscall", "rva": "0x1c0", "evidence": "public_sdk_constant"}},
          {"const": {"name": "copyout", "rva": "0x2bd950", "evidence": "local_read_only_anchor_check"}},
