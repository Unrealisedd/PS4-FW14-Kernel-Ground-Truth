      "properties": {
        "capture_size": {"const": 44040192},
        "capture_sha256": {"const": "8b2fe4b1c1ef3504cbf871bea31b4fb6d36b83158fcabf58bd89fc2c872ca0a2"},
        "analysis_elf_sha256": {"const": "b20a94820aef512490d6167497eb00f9eaa5c780814fe19361b4f00cb7713c3b"}
